<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DeepSeek"
            android:textColor="?attr/appTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"/>

        <Button
            android:id="@+id/btn_ds_debug"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="🔍"
            android:textColor="?attr/appAccent"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/btn_ds_read"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="📖"
            android:textColor="?attr/appAccent"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/btn_ds_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="Закрыть"
            android:textColor="?attr/appAccent"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/ds_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="?attr/appAccent"
        android:progress="0"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/ds_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="?attr/appTextSecondary"
        android:textSize="11sp"
        android:text=""/>

    <WebView
        android:id="@+id/ds_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
