<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Разработка"
            android:textColor="?attr/appTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"/>

        <Button
            android:id="@+id/btn_close_dev"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="Закрыть"
            android:textColor="?attr/appAccent"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/input_dev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Задача для AI-dev..."
            android:textColorHint="?attr/appTextSecondary"
            android:textColor="?attr/appTextPrimary"
            android:background="@drawable/bg_input"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minLines="1"
            android:maxLines="3"
            android:gravity="center_vertical|start"
            android:inputType="textMultiLine|textCapSentences"
            android:fontFamily="@font/syne"/>

        <Button
            android:id="@+id/btn_dev_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="→"
            android:textSize="22sp"
            style="@style/PrimaryButton"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/tab_git"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="📦 Git"
            android:textSize="12sp"
            android:textAllCaps="false"
            style="@style/PrimaryButton"/>

        <Button
            android:id="@+id/tab_aidev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:minHeight="0dp"
            android:text="🛠 AI-Dev"
            android:textSize="12sp"
            android:textAllCaps="false"
            style="@style/SecondaryButton"/>

        <Button
            android:id="@+id/tab_patches"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:minHeight="0dp"
            android:text="📝 Патчи"
            android:textSize="12sp"
            android:textAllCaps="false"
            style="@style/SecondaryButton"/>
    </LinearLayout>

    <TextView
        android:id="@+id/dev_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/appTextSecondary"
        android:textSize="12sp"
        android:text=""/>

    <ListView
        android:id="@+id/list_dev"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay"
        android:divider="@null"
        android:dividerHeight="0dp"/>

</LinearLayout>
