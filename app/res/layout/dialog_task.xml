<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/appBgCard"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dlg_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingEnd="8dp"/>

            <TextView
                android:id="@+id/dlg_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/appTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/dlg_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextSecondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Задача"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/dlg_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appBgInput"
            android:padding="10dp"
            android:textColor="?attr/appTextPrimary"
            android:textSize="14sp"
            android:textIsSelectable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вывод"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/dlg_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appBgInput"
            android:padding="10dp"
            android:textColor="?attr/appTextPrimary"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <Button
                android:id="@+id/dlg_retry"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Повторить"
                style="@style/PrimaryButton"/>

            <Button
                android:id="@+id/dlg_copy"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Копировать"/>

            <Button
                android:id="@+id/dlg_delete"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Удалить"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
