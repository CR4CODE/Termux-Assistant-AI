<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dlg_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingEnd="8dp"/>

            <TextView
                android:id="@+id/dlg_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/appTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/dlg_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextSecondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Задача"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"/>

        <TextView
            android:id="@+id/dlg_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:textColor="?attr/appTextPrimary"
            android:textSize="14sp"
            android:textIsSelectable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вывод"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"/>

        <TextView
            android:id="@+id/dlg_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:textColor="?attr/appTextPrimary"
            android:textSize="12sp"
            android:fontFamily="@font/jetbrains_mono"
            android:textIsSelectable="true"
            android:lineSpacingExtra="3dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <Button
                android:id="@+id/dlg_retry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Повторить"
                android:textSize="13sp"
                style="@style/PrimaryButton"/>

            <Button
                android:id="@+id/dlg_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Копировать"
                android:textSize="13sp"
                style="@style/SecondaryButton"/>

            <Button
                android:id="@+id/dlg_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Удалить"
                android:textSize="13sp"
                style="@style/SecondaryButton"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
