<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg"
    android:fitsSystemWindows="true">

    <!-- Шапка: ≡ | DeepSeek · статус | 🤖 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="≡"
            android:textColor="?attr/appTextPrimary"
            android:textSize="22sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"/>

        <TextView
            android:id="@+id/ds_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="DeepSeek"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/ds_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="?attr/appAccent"
        android:progress="0"
        android:visibility="gone"/>

    <com.termux.assistant.LockableWebView
        android:id="@+id/ds_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Нижняя панель: 📥 | 🚀 Free | 🗑 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/appBgCard"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_ds_from_clip"
            android:layout_width="40dp"
            android:layout_height="46dp"
            android:text="📥"
            android:textSize="18sp"
            style="@style/PanelButton.Secondary"/>

        <Button
            android:id="@+id/btn_ds_free"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="🚀 Free"
            android:textSize="12sp"
            style="@style/PanelButton.Primary"/>

        <Button
            android:id="@+id/btn_ds_dev"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="🆕 Vibe"
            android:textSize="12sp"
            style="@style/PanelButton.Secondary"/>

        <Button
            android:id="@+id/btn_ds_kbd"
            android:layout_width="40dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:text="⌨️"
            android:textSize="18sp"
            style="@style/PanelButton.Secondary"/>

        <Button
            android:id="@+id/btn_ds_clear"
            android:layout_width="40dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:text="🗑"
            android:textSize="18sp"
            style="@style/PanelButton.Secondary"/>
    </LinearLayout>

</LinearLayout>
