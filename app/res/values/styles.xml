<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
    <item name="appBg">#121214</item>
    <item name="appBgCard">#1A1A1D</item>
    <item name="appBgInput">#232326</item>
    <item name="appTextPrimary">#E8E5DF</item>
    <item name="appTextSecondary">#8A8780</item>
    <item name="appAccent">#22C55E</item>
    <item name="appDivider">#2A2A2E</item>
    <item name="android:windowBackground">@drawable/splash_bg</item>
    <item name="android:statusBarColor">?attr/appBg</item>
    <item name="android:navigationBarColor">?attr/appBg</item>
    <item name="android:textViewStyle">@style/AppTextView</item>
    <item name="android:buttonStyle">@style/AppButton</item>
    <item name="android:colorControlActivated">#22C55E</item>
    <item name="android:colorControlNormal">?attr/appTextSecondary</item>
  </style>

  <style name="AppTheme.Dark" parent="android:Theme.Material.NoActionBar">
    <item name="appBg">#121214</item>
    <item name="appBgCard">#1A1A1D</item>
    <item name="appBgInput">#232326</item>
    <item name="appTextPrimary">#E8E5DF</item>
    <item name="appTextSecondary">#8A8780</item>
    <item name="appAccent">#22C55E</item>
    <item name="appDivider">#2A2A2E</item>
    <item name="android:windowBackground">@drawable/splash_bg</item>
    <item name="android:statusBarColor">?attr/appBg</item>
    <item name="android:navigationBarColor">?attr/appBg</item>
    <item name="android:textViewStyle">@style/AppTextView</item>
    <item name="android:buttonStyle">@style/AppButton</item>
    <item name="android:colorControlActivated">#22C55E</item>
    <item name="android:colorControlNormal">?attr/appTextSecondary</item>
  </style>

  <style name="AppTheme.Light" parent="android:Theme.Material.Light.NoActionBar">
    <item name="appBg">#FAF8F5</item>
    <item name="appBgCard">#FFFFFF</item>
    <item name="appBgInput">#F0EDE8</item>
    <item name="appTextPrimary">#1A1A1D</item>
    <item name="appTextSecondary">#5C5A55</item>
    <item name="appAccent">#16A34A</item>
    <item name="appDivider">#E5E0D8</item>
    <item name="android:windowBackground">@drawable/splash_bg</item>
    <item name="android:statusBarColor">?attr/appBg</item>
    <item name="android:navigationBarColor">?attr/appBg</item>
    <item name="android:textViewStyle">@style/AppTextView</item>
    <item name="android:buttonStyle">@style/AppButton</item>
    <item name="android:colorControlActivated">#16A34A</item>
    <item name="android:colorControlNormal">?attr/appTextSecondary</item>
  </style>

  <style name="Card">
    <item name="android:background">@drawable/bg_card</item>
    <item name="android:padding">16dp</item>
    <item name="android:layout_marginBottom">12dp</item>
  </style>

  <style name="PrimaryButton" parent="android:Widget.Material.Button">
    <item name="android:background">@drawable/btn_primary</item>
    <item name="android:textColor">#FFFFFF</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0.02</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:paddingLeft">20dp</item>
    <item name="android:paddingRight">20dp</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">12dp</item>
    <item name="android:fontFamily">@font/syne</item>
  </style>


  <style name="SecondaryButton" parent="android:Widget.Material.Button">
    <item name="android:background">@drawable/btn_secondary</item>
    <item name="android:textColor">?attr/appTextPrimary</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">15sp</item>
    <item name="android:letterSpacing">0.02</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:paddingLeft">20dp</item>
    <item name="android:paddingRight">20dp</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">12dp</item>
    <item name="android:fontFamily">@font/syne</item>
  </style>

  <style name="SectionHeader">
    <item name="android:textColor">?attr/appTextPrimary</item>
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:layout_marginTop">24dp</item>
    <item name="android:layout_marginBottom">12dp</item>
    <item name="android:fontFamily">@font/syne</item>
  </style>

  <style name="InputField" parent="android:Widget.Material.EditText">
    <item name="android:background">@drawable/bg_input</item>
    <item name="android:textColor">?attr/appTextPrimary</item>
    <item name="android:textColorHint">?attr/appTextSecondary</item>
    <item name="android:textSize">16sp</item>
    <item name="android:paddingLeft">16dp</item>
    <item name="android:paddingRight">16dp</item>
    <item name="android:paddingTop">14dp</item>
    <item name="android:paddingBottom">14dp</item>
  </style>


  <style name="AppTextView" parent="android:Widget.Material.TextView">
    <item name="android:fontFamily">@font/syne</item>
  </style>

  <style name="AppButton" parent="android:Widget.Material.Button">
    <item name="android:fontFamily">@font/syne</item>
  </style>


  <style name="PanelButton" parent="android:Widget.Material.Button">
    <item name="android:textColor">?attr/appTextPrimary</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">12sp</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:paddingLeft">0dp</item>
    <item name="android:paddingRight">0dp</item>
    <item name="android:paddingTop">0dp</item>
    <item name="android:paddingBottom">0dp</item>
    <item name="android:insetLeft">0dp</item>
    <item name="android:insetRight">0dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
  </style>

  <style name="PanelButton.Primary" parent="PanelButton">
    <item name="android:background">@drawable/btn_primary</item>
    <item name="android:textColor">#FFFFFF</item>
  </style>

  <style name="PanelButton.Secondary" parent="PanelButton">
    <item name="android:background">@drawable/btn_secondary</item>
  </style>

</resources>
