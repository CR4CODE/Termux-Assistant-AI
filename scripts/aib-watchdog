#!/usr/bin/env python3
"""watchdog для receiver.py: если упал — перезапускает."""
import os, sys, time, subprocess, socket

RUN = os.path.expanduser("~/projects/termux-ai-kit/a11y-apk/run")
REC = os.path.join(RUN, "receiver.py")
PID = os.path.join(RUN, "receiver.pid")

def is_alive():
    try:
        pid = int(open(PID).read().strip())
        os.kill(pid, 0)
        # проверим, что порт 8765 слушается
        try:
            s = socket.create_connection(("127.0.0.1", 8765), timeout=1)
            s.close()
            return True
        except Exception:
            return False
    except Exception:
        return False

def start():
    print(f"[{time.strftime('%H:%M:%S')}] receiver мёртв — перезапуск", flush=True)
    subprocess.Popen(["nohup", "python3", "-u", REC],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     cwd=RUN, start_new_session=True)
    time.sleep(2)
    try:
        out = subprocess.check_output(["pgrep", "-f", "receiver.py"]).decode().strip().split("\n")
        if out:
            open(PID, "w").write(out[-1])
            print(f"  → запущен PID {out[-1]}", flush=True)
    except Exception as e:
        print(f"  ! не смог запустить: {e}", flush=True)

if __name__ == "__main__":
    interval = int(sys.argv[1]) if len(sys.argv) > 1 else 15
    print(f"watchdog: проверяю каждые {interval}s. Ctrl+C — стоп.", flush=True)
    try:
        while True:
            if not is_alive():
                start()
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\nстоп.")
