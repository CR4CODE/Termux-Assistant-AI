#!/data/data/com.termux/files/usr/bin/python3
"""ai-tasker-server — HTTP-сервер обмена между приложением и Termux.

Слушает 127.0.0.1:8767.

POST /task
  Тело: {"task": "auto:uptime"}
  Ответ: {"status":"success","output":"...","exit_code":0}

GET /health
  Ответ: {"ok": true, "version": "1"}
"""
import json
import os
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = "127.0.0.1"
PORT = 8767
HOME = os.path.expanduser("~")
ROUTER = os.path.join(HOME, "bin", "ai-router")
APPLY = os.path.join(HOME, "bin", "apply-patches")


def log(msg):
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


def run_router(code, timeout=300):
    try:
        r = subprocess.run([ROUTER, code], capture_output=True, timeout=timeout)
        out = r.stdout.decode("utf-8", "replace")
        err = r.stderr.decode("utf-8", "replace")
        combined = out + ("\n" + err if err else "")
        lines = [l for l in combined.split("\n") if not l.startswith("[router]")]
        result = "\n".join(lines).strip()
        return result or f"(пустой вывод, rc={r.returncode})", r.returncode
    except subprocess.TimeoutExpired:
        return f"(TIMEOUT {timeout}s)", 124
    except Exception as e:
        return f"(ошибка: {e})", 1


def run_apply_patches(timeout=1800):
    try:
        r = subprocess.run(["bash", APPLY], capture_output=True, timeout=timeout)
        out = r.stdout.decode("utf-8", "replace")
        err = r.stderr.decode("utf-8", "replace")
        combined = (out + ("\n" + err if err else "")).strip()
        return combined, r.returncode
    except subprocess.TimeoutExpired:
        return f"(TIMEOUT {timeout}s)", 124
    except Exception as e:
        return f"(ошибка: {e})", 1


def run_export_source():
    script = os.path.join(HOME, "bin", "export-source")
    if not os.path.exists(script):
        return "export-source не найден", 1
    try:
        r = subprocess.run(["bash", script], capture_output=True, timeout=60)
        return (r.stdout.decode("utf-8", "replace") or "OK").strip(), r.returncode
    except Exception as e:
        return f"(ошибка: {e})", 1


def vk_config_path():
    return os.path.expanduser("~/.config/ai-tasker/vk.json")


def vk_save_config(gid, token):
    p = vk_config_path()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    os.chmod(os.path.dirname(p), 0o700)
    try:
        cfg = {}
        if os.path.exists(p):
            with open(p, "r", encoding="utf-8") as f:
                cfg = json.load(f)
        cfg["access_token"] = token
        cfg["group_id"] = int(gid)
        with open(p, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False)
        os.chmod(p, 0o600)
        return f"Сохранено: group_id={gid}, token длина {len(token)}", 0
    except Exception as e:
        return f"Ошибка сохранения: {e}", 1


def vk_facts():
    """Собирает факты о проекте для генерации поста."""
    import subprocess as sp
    home = os.path.expanduser("~")
    repo = os.path.join(home, "projects", "termux-assistant-ai")
    parts = []

    # 1. Последние 15 коммитов
    try:
        r = sp.run(["git", "-C", repo, "log", "--oneline", "-15"],
                   capture_output=True, timeout=10)
        log = r.stdout.decode("utf-8", "replace").strip()
        if log:
            parts.append("=== Последние коммиты ===\n" + log)
    except Exception as e:
        parts.append(f"git log err: {e}")

    # 2. Последние 2 тега
    try:
        r = sp.run(["git", "-C", repo, "tag", "--sort=-creatordate"],
                   capture_output=True, timeout=10)
        tags = r.stdout.decode("utf-8", "replace").strip().split("\n")[:3]
        if tags:
            parts.append("=== Последние релизы ===\n" + ", ".join(t for t in tags if t))
    except Exception:
        pass

    # 3. Текущая версия из build.sh
    try:
        bs = os.path.join(home, "projects", "termux-ai-kit", "ai-tasker-app", "build.sh")
        with open(bs, "r", encoding="utf-8") as f:
            content = f.read()
        import re as _re
        m = _re.search(r"--version-name (\S+)", content)
        if m:
            parts.append("=== Текущая версия ===\n" + m.group(1))
    except Exception:
        pass

    # 4. Верхний блок CHANGELOG
    try:
        cl = os.path.join(repo, "CHANGELOG.md")
        with open(cl, "r", encoding="utf-8") as f:
            content = f.read()
        # Первый блок до второго "## ["
        idx2 = content.find("## [", 5)
        head = content[:idx2] if idx2 > 0 else content[:2000]
        parts.append("=== Последний CHANGELOG ===\n" + head.strip()[:1500])
    except Exception:
        pass

    return "\n\n".join(parts) or "(нет данных)", 0


def release_path(kind, version):
    return os.path.expanduser(f"~/.config/ai-tasker/release-{kind}-{version}.md")


def release_save(kind, version, b64text):
    import base64 as _b64
    try:
        text = _b64.b64decode(b64text.encode("utf-8")).decode("utf-8")
    except Exception as e:
        return f"base64 err: {e}", 1
    p = release_path(kind, version)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        f.write(text)
    return f"saved: {kind} ({len(text)} chars)", 0


def release_run(version, vk=True):
    script = os.path.expanduser("~/bin/auto-release")
    if not os.path.exists(script):
        return "auto-release не найден", 1
    notes = release_path("notes", version)
    ch = release_path("changelog", version)
    vkf = release_path("vk", version)
    cmd = [script, version]
    if os.path.exists(notes):
        cmd += ["--notes-file", notes]
    if os.path.exists(ch):
        cmd += ["--changelog-file", ch]
    if os.path.exists(vkf) and vk:
        cmd += ["--vk-post-file", vkf]
    if not vk:
        cmd += ["--no-vk"]
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=600)
        out = r.stdout.decode("utf-8", "replace")
        err = r.stderr.decode("utf-8", "replace")
        return (out + ("\n" + err if err else "")).strip(), r.returncode
    except subprocess.TimeoutExpired:
        return "(TIMEOUT 600s)", 124
    except Exception as e:
        return f"(ошибка: {e})", 1


def vk_post(text):
    script = os.path.expanduser("~/bin/vk-post")
    if not os.path.exists(script):
        return "vk-post не найден", 1
    try:
        r = subprocess.run([script, text], capture_output=True, timeout=60)
        out = r.stdout.decode("utf-8", "replace")
        err = r.stderr.decode("utf-8", "replace")
        combined = (out + ("\n" + err if err else "")).strip()
        return combined or "(пусто)", r.returncode
    except Exception as e:
        return f"(ошибка: {e})", 1


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def _send(self, code, payload):
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/health":
            self._send(200, {"ok": True, "version": "1"})
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if self.path != "/task":
            self._send(404, {"error": "not found"})
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            raw = self.rfile.read(length).decode("utf-8")
            data = json.loads(raw)
            task = data.get("task", "")
        except Exception as e:
            self._send(400, {"status": "error", "output": f"bad request: {e}", "exit_code": 1})
            return

        log(f"TASK: {task[:80]!r}")
        started = time.time()

        if task.startswith("apply_patches:"):
            output, rc = run_apply_patches()
        elif task.startswith("export_source:"):
            output, rc = run_export_source()
        elif task.startswith("vk_facts:"):
            output, rc = vk_facts()
        elif task.startswith("release_notes:"):
            rest = task[14:]
            parts = rest.split(":", 1)
            output, rc = release_save("notes", parts[0], parts[1] if len(parts) > 1 else "")
        elif task.startswith("release_changelog:"):
            rest = task[18:]
            parts = rest.split(":", 1)
            output, rc = release_save("changelog", parts[0], parts[1] if len(parts) > 1 else "")
        elif task.startswith("release_vk:"):
            rest = task[11:]
            parts = rest.split(":", 1)
            output, rc = release_save("vk", parts[0], parts[1] if len(parts) > 1 else "")
        elif task.startswith("release_run:"):
            rest = task[12:]
            parts = rest.split(":", 1)
            vk_flag = (parts[1] != "no_vk") if len(parts) > 1 else True
            output, rc = release_run(parts[0], vk=vk_flag)
        elif task.startswith("vk_post:"):
            output, rc = vk_post(task[8:].strip())
        elif task.startswith("vk_config:"):
            rest = task[10:]
            parts = rest.split(":", 1)
            if len(parts) == 2:
                try:
                    gid = int(parts[0])
                except ValueError:
                    gid = 0
                output, rc = vk_save_config(gid, parts[1])
            else:
                output, rc = "Неверный формат vk_config", 1
        elif task.startswith("auto:"):
            output, rc = run_router(task[5:].strip())
        else:
            output, rc = run_router(task)

        elapsed = round(time.time() - started, 2)
        log(f"  -> rc={rc} len={len(output)} time={elapsed}s")

        self._send(200, {
            "status": "success" if rc == 0 else "error",
            "output": output[:20000],
            "exit_code": rc,
            "elapsed": elapsed,
        })


if __name__ == "__main__":
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    log(f"=== ai-tasker-server запущен на {HOST}:{PORT} ===")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log("=== остановлен ===")
