#!/usr/bin/env python3
"""Обрезает receiver.log если он больше 1 МБ, оставляя последние 500 строк."""
import os
LOG = os.path.expanduser("~/projects/termux-ai-kit/a11y-apk/run/receiver.log")
LIMIT = 1024 * 1024
if not os.path.exists(LOG): raise SystemExit(0)
size = os.path.getsize(LOG)
if size < LIMIT: raise SystemExit(0)
with open(LOG, "rb") as f:
    f.seek(max(0, size - 200_000))
    tail = f.read().decode("utf-8", "replace").splitlines()[-500:]
with open(LOG, "w") as f:
    f.write("\n".join(tail) + "\n")
print(f"rotated: {size} -> {os.path.getsize(LOG)}")
