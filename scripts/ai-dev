#!/usr/bin/env python3
"""ai-dev — автономная разработка APK. Подменяет промпт на dev-версию."""
import sys, os

WORKDIR = os.path.expanduser("~/projects/termux-ai-kit/ai-tasker-app")
MAX_ITER = 30
DEV_PROMPT = os.path.expanduser("~/.aib/dev-prompt.txt")

args = sys.argv[1:]
if not args:
    print("usage: ai-dev \"задача\" [--workdir PATH] [--max N]")
    sys.exit(0)

task = args[0]
if "--workdir" in args:
    WORKDIR = os.path.expanduser(args[args.index("--workdir") + 1])
if "--max" in args:
    MAX_ITER = int(args[args.index("--max") + 1])

if not os.path.exists(DEV_PROMPT):
    print(f"!!! dev-prompt не найден: {DEV_PROMPT}")
    sys.exit(1)

print(f">>> Режим РАЗРАБОТКИ: {WORKDIR}")
print(f">>> Промпт: {DEV_PROMPT}")
print(f">>> Лимит: {MAX_ITER} итераций")
print()

env = os.environ.copy()
env["AIB_PROMPT_FILE"] = DEV_PROMPT

os.execvpe(os.path.expanduser("~/bin/aib-auto"),
           [os.path.expanduser("~/bin/aib-auto"),
            task,
            "--workdir", WORKDIR,
            "--max", str(MAX_ITER)],
           env)
